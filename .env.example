VITE_API_URL=https://api.sydapp.com.br
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=https://n8n.psiativa.com.br/webhook/syd-contato

# Google Analytics - Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google Tag Manager - Container ID (e.g. GTM-XXXXXXX)
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_GOOGLE_TAG_ID=AW-XXXXXXXXX

# Microsoft Clarity - Project ID
PUBLIC_CLARITY_ID=xxxxxxxxxx

# ── FTP deploy (cPanel, scoped) ─────────────────────────────────────────────
# Transport is FTP, NEVER SSH/scp/rsync. The origin is a SHARED hosting account
# under a process cap that refuses processes ACCOUNT-WIDE when exceeded.
#
# The login is a per-directory FTP account jailed to THIS docroot
# (/home/zokucomb/domains/spaceapps/syd/sydapp.com.br),
# created over cPanel API2 Ftp::addftp and confirmed with Ftp::listftp.
CPANEL_FTP_HOST=pro122.dnspro.com.br
CPANEL_FTP_PORT=21
CPANEL_FTP_USER=deploy@sydapp.com.br
CPANEL_FTP_PASSWORD=

# A chrooted login's own path is "/" and can never name the host, so the docroot
# identity check is waived only because this is DECLARED.
CPANEL_FTP_SCOPED=true

# This host advertises AUTH TLS in FEAT and then 500s on every scheme.
# The script fails closed; this is how the plaintext choice is stated out loud.
CPANEL_FTP_TLS=false

# Docroot relative to /home/zokucomb. Ignored while CPANEL_FTP_SCOPED=true.
CPANEL_DOCROOT_BASE=domains/spaceapps/syd/sydapp.com.br

# cPanel API credentials for process quota preflights.
CPANEL_API_USER=zokucomb
CPANEL_API_TOKEN=

# Sibling sites on this shared account (used for misroute detection).
CPANEL_SIBLING_SITES=
